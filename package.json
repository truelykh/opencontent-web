{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f ../db/postgresql/docker-compose.yml up -d",
    "db:down": "docker compose -f ../db/postgresql/docker-compose.yml down",
    "db:reset": "docker compose -f ../db/postgresql/docker-compose.yml down -v && docker compose -f ../db/postgresql/docker-compose.yml up -d"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
