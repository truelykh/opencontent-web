# One database per bounded context.
# Production
IDENTITY_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_identity
PROFILE_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_profile
SESSION_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_session
MEDIA_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_media
COMMENTS_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_comments
VIEWS_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_views
LIKES_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_likes
SHOP_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/openconnect_shop

# Test (used by the test runner — never touch prod data)
TEST_IDENTITY_DATABASE_URL=postgresql://<test-user>:<test-password>@<test-host>:<test-port>/openconnect_test_identity
TEST_PROFILE_DATABASE_URL=postgresql://<test-user>:<test-password>@<test-host>:<test-port>/openconnect_test_profile
TEST_SESSION_DATABASE_URL=postgresql://<test-user>:<test-password>@<test-host>:<test-port>/openconnect_test_session
